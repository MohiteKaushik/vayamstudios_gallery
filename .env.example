# Copy to .env and fill in. Never commit .env itself.

# --- Admin console ---------------------------------------------------------
# The single operator account. Use a strong password: this account can read
# every member's contact details.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# --- Sessions --------------------------------------------------------------
# Signs the session cookie. Generate a fresh one and keep it secret; changing
# it signs everyone out. Create with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- Cloudflare R2 ---------------------------------------------------------
# Public bucket URL, used only for assets that are safe to serve without a
# session. Photos are served through the Worker instead.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
