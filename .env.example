# Copy to .env and fill in. Never commit .env itself.

# --- Admin console ---------------------------------------------------------
# The single operator account. Use a strong password: this account can read
# every member's contact details.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# --- Sessions --------------------------------------------------------------
# Signs the session cookie. Generate a fresh one and keep it secret; changing
# it signs everyone out. Create with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- Google sign-in ---------------------------------------------------------
# Create an OAuth web client in Google Cloud and add this redirect URI:
#   http://localhost:5173/api/auth/google/callback
# Also add your deployed callback URL when publishing the site.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Use only when Google already has an exact redirect URI registered,
# for example http://localhost:8787 during local testing.
GOOGLE_REDIRECT_URI=""

# --- Cloudflare R2 ---------------------------------------------------------
# Public bucket URL, used only for assets that are safe to serve without a
# session. Photos are served through the Worker instead.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
# Set to "true" after `wrangler login`, or set CLOUDFLARE_API_TOKEN, when you
# want local dev to read the real Cloudflare R2 bucket instead of local storage.
CLOUDFLARE_REMOTE_BINDINGS="false"
