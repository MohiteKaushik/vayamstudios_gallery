{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayamstudios-gallery",
  // Must not run ahead of the workerd bundled with the installed wrangler.
  // A date in the future fails to boot with ERR_FUTURE_COMPATIBILITY_DATE,
  // so raise this only alongside a wrangler upgrade.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Our own entry, which handles /media/* and then hands everything else to
  // TanStack. Pointing this at the framework entry instead means the media
  // routes never run and every photo request 404s.
  "main": "src/server.ts",
  "observability": { "enabled": true },

  // The interface is served as static assets. Those are free and unlimited on
  // both the free and paid plans, so hosting the app itself costs nothing.
  // Only requests that reach the Worker count against the request quota.
  //
  // The paid plan is required regardless: the free plan allows ten
  // milliseconds of CPU per request, and verifying a password alone takes
  // eighty.

  // Photos, thumbnails and every record in the product. There is no separate
  // database; see src/lib/storage.server.ts for why R2 alone is sufficient.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "vayam-photos"
    }
  ],

  // The face pre-index. 128 dimensions matches the current face-api
  // descriptor. Euclidean metric, so the browser and the index measure
  // distance the same way and MATCH_MAX_DISTANCE means one thing everywhere.
  //
  //   npx wrangler vectorize create vayam-faces --dimensions=128 --metric=euclidean
  "vectorize": [
    {
      "binding": "FACE_INDEX",
      "index_name": "vayam-faces",
      // Cloudflare cannot emulate Vectorize locally, so without this the
      // binding is simply absent in dev and every upload reports its faces as
      // stored but not searchable. "remote" makes local development talk to
      // the real index. It needs "wrangler login" to have been run.
      "remote": true
    }
  ],

  // Not secret. The public bucket is for assets that are safe without a
  // session; photos are served through the Worker behind a session check.
  "vars": {
    "R2_PUBLIC_URL": "https://pub-caf4c5ddf0424d7a903e671fc2a45b86.r2.dev"
  }

  // Secrets are NOT listed here. Set them once per environment with:
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put ADMIN_EMAIL
  //   npx wrangler secret put ADMIN_PASSWORD
  // Locally they are read from .env, which is gitignored.
}
